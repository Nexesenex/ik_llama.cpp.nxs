{
  "version": 4,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_RPATH": "$ORIGIN;$ORIGIN/.."
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "reldbg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "cpu-avx2-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "GGML_NATIVE": "OFF",
        "GGML_AVX": "ON",
        "GGML_AVX2": "ON",
        "GGML_FMA": "ON",
        "GGML_F16C": "ON",
        "GGML_BLAS": "OFF",
        "GGML_CUDA": "OFF"
      }
    },
    {
      "name": "cuda-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "GGML_CUDA": "ON",
        "GGML_BLAS": "OFF"
      }
    },
    {
      "name": "cpu-avx2-debug",
      "inherits": [
        "cpu-avx2-base",
        "debug"
      ],
      "binaryDir": "${sourceDir}/build_cpu_avx2_debug"
    },
    {
      "name": "cpu-avx2-release",
      "inherits": [
        "cpu-avx2-base",
        "release"
      ],
      "binaryDir": "${sourceDir}/build_cpu_avx2_release"
    },
    {
      "name": "cpu-avx2-reldbg",
      "inherits": [
        "cpu-avx2-base",
        "reldbg"
      ],
      "binaryDir": "${sourceDir}/build_cpu_avx2_reldbg"
    },
    {
      "name": "gcc_cpu_base",
      "hidden": true,
      "inherits": "cpu-avx2-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "Q:/w64devkit/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "Q:/w64devkit/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "Q:/w64devkit/w64devkit/bin/ninja.exe",
        "GGML_AVXVNNI": "ON",
        "GGML_AVXVNNIINT8": "ON",
        "GGML_AVX_NE_CONVERT": "ON",
        "GGML_AVX_IFMA": "ON",
        "GGML_CMPCCXADD": "ON",
        "GGML_OPENMP": "ON",
        "GGML_CCACHE": "OFF",
        "GGML_IQK_FA_ALL_QUANTS": "ON",
        "GGML_SCHED_MAX_COPIES": "1",
        "GGML_MAX_CONTEXTS": "2048",
        "GGML_THREADPOOL": "ON"
      }
    },
    {
      "name": "gcc_cpu_release",
      "inherits": [
        "gcc_cpu_base",
        "release"
      ],
      "binaryDir": "${sourceDir}/build_gcc_cpu_release"
    },
    {
      "name": "cuda-debug",
      "inherits": [
        "cuda-base",
        "debug"
      ],
      "binaryDir": "${sourceDir}/build_debug"
    },
    {
      "name": "cuda-release",
      "inherits": [
        "cuda-base",
        "release"
      ],
      "binaryDir": "${sourceDir}/build_release"
    },
    {
      "name": "cuda-reldbg",
      "inherits": [
        "cuda-base",
        "reldbg"
      ],
      "binaryDir": "${sourceDir}/build_cuda_reldbg"
    },
    {
      "name": "cpu-avx2-pgo-instr",
      "inherits": [
        "cpu-avx2-base",
        "release"
      ],
      "binaryDir": "${sourceDir}/build_pgo_instr",
      "cacheVariables": {
        "GGML_PGO_INSTRUMENT": "ON",
        "GGML_LTO": "OFF"
      }
    },
    {
      "name": "cpu-avx2-pgo-opt",
      "inherits": [
        "cpu-avx2-base",
        "release"
      ],
      "binaryDir": "${sourceDir}/build_pgo_opt",
      "cacheVariables": {
        "GGML_PGO_USE": "${sourceDir}/pgo/train.profdata",
        "GGML_LTO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "parallel-build",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "cpu-avx2-debug",
      "configurePreset": "cpu-avx2-debug",
      "inherits": "parallel-build"
    },
    {
      "name": "cpu-avx2-release",
      "configurePreset": "cpu-avx2-release",
      "inherits": "parallel-build"
    },
    {
      "name": "cpu-avx2-reldbg",
      "configurePreset": "cpu-avx2-reldbg",
      "inherits": "parallel-build"
    },
    {
      "name": "gcc_cpu_release",
      "configurePreset": "gcc_cpu_release",
      "inherits": "parallel-build"
    },
    {
      "name": "cuda-debug",
      "configurePreset": "cuda-debug",
      "inherits": "parallel-build"
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release",
      "inherits": "parallel-build"
    },
    {
      "name": "cuda-reldbg",
      "configurePreset": "cuda-reldbg",
      "inherits": "parallel-build"
    },
    {
      "name": "cpu-avx2-pgo-instr",
      "configurePreset": "cpu-avx2-pgo-instr",
      "inherits": "parallel-build"
    },
    {
      "name": "cpu-avx2-pgo-opt",
      "configurePreset": "cpu-avx2-pgo-opt",
      "inherits": "parallel-build"
    }
  ]
}
